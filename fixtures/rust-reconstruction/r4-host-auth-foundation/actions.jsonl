{"ordinal": 1, "scenario": "fixed-bind-receives-requested-port", "actor": "harness", "kind": "listener.bind", "plan": {"host": {"literal": "127.0.0.1"}, "port": "ephemeral", "resolution_bound": 4, "attempt_bound": 4}, "note": "Borrow a port the operating system confirms is free. Guessing a constant here would make the scenario depend on what else the host happens to be running."}
{"ordinal": 2, "scenario": "fixed-bind-receives-requested-port", "actor": "harness", "kind": "listener.close", "expect": {"released": true}, "note": "Release the borrowed port so the fixed bind below is the only owner."}
{"ordinal": 3, "scenario": "fixed-bind-receives-requested-port", "actor": "harness", "kind": "listener.bind", "plan": {"host": {"literal": "127.0.0.1"}, "port": {"fixed": "<port observed at ordinal 1>"}, "resolution_bound": 4, "attempt_bound": 4}, "expect": {"acquired": true}}
{"ordinal": 4, "scenario": "fixed-bind-receives-requested-port", "actor": "harness", "kind": "listener.observe-receipt", "expect": {"requested_host": {"literal": "127.0.0.1"}, "requested_port": {"fixed": "<port observed at ordinal 1>"}, "observed_address": "127.0.0.1:<port observed at ordinal 1>"}}
{"ordinal": 5, "scenario": "ephemeral-bind-observes-assigned-port", "actor": "harness", "kind": "listener.bind", "plan": {"host": {"literal": "127.0.0.1"}, "port": "ephemeral", "resolution_bound": 4, "attempt_bound": 4}, "expect": {"acquired": true}}
{"ordinal": 6, "scenario": "ephemeral-bind-observes-assigned-port", "actor": "harness", "kind": "listener.observe-receipt", "expect": {"requested_port": "ephemeral", "requested_port_asks_for": 0, "observed_host": "127.0.0.1", "observed_port_is_zero": false}, "note": "The requested port is zero and the observed port never is. A receipt that echoed the request would be wrong in precisely the case it is consulted."}
{"ordinal": 7, "scenario": "bind-conflict-refused-owner-undamaged", "actor": "harness", "kind": "listener.bind", "plan": {"host": {"literal": "127.0.0.1"}, "port": "ephemeral", "resolution_bound": 4, "attempt_bound": 4}, "expect": {"acquired": true}, "note": "This listener is held for the remainder of the scenario."}
{"ordinal": 8, "scenario": "bind-conflict-refused-owner-undamaged", "actor": "harness", "kind": "listener.bind", "plan": {"host": {"literal": "127.0.0.1"}, "port": {"fixed": "<port observed at ordinal 7>"}, "resolution_bound": 4, "attempt_bound": 4}, "expect": {"acquired": false}}
{"ordinal": 9, "scenario": "bind-conflict-refused-owner-undamaged", "actor": "harness", "kind": "expect.refusal", "expect": {"classification": "address-in-use", "address": "127.0.0.1:<port observed at ordinal 7>", "classified_from": "error-kind", "classified_from_message_text": false}}
{"ordinal": 10, "scenario": "bind-conflict-refused-owner-undamaged", "actor": "harness", "kind": "listener.connect", "target": "127.0.0.1:<port observed at ordinal 7>", "expect": {"connection_completed": true}, "note": "Undamaged is proved against the socket, not the cached receipt: a live listener still completes a connection from its backlog, which it could not do had the refused attempt disturbed it. Accepting the connection is not this crate's job."}
{"ordinal": 11, "scenario": "resolution-bound-refused-before-bind", "actor": "harness", "kind": "resolver.configure", "answers": [{"name": "wide.test", "addresses": ["127.0.0.1", "127.0.0.1", "127.0.0.1"]}], "note": "A deterministic in-process resolver. No name reaches the platform."}
{"ordinal": 12, "scenario": "resolution-bound-refused-before-bind", "actor": "harness", "kind": "listener.bind", "plan": {"host": {"name": "wide.test"}, "port": "ephemeral", "resolution_bound": 2, "attempt_bound": 4}, "expect": {"acquired": false}}
{"ordinal": 13, "scenario": "resolution-bound-refused-before-bind", "actor": "harness", "kind": "expect.refusal", "expect": {"classification": "resolution-too-many-addresses", "produced": 3, "limit": 2, "bind_attempts": 0}, "note": "The refusal names the resolution bound rather than any bind outcome. Every candidate is loopback, so a single attempted bind would have succeeded and returned a listener instead."}
