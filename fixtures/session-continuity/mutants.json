{
  "schema_version": 1,
  "prefix": "CONTINUITY",
  "mutants": [
    {
      "id": "CONTINUITY-PUBLISHED-CANCEL",
      "law": "J01: an interrupt that arrives after a compaction descriptor is published cannot disown the durable compaction.",
      "edits": [
        {
          "path": "crates/grapt-product/src/dogfood/continuation/compaction.rs",
          "before": "        (Ok(()), _) => Ok(Ok(())),\n        (Err(_), Some(by)) => Err(by),",
          "after": "        (_, Some(by)) => Err(by),\n        (Ok(()), None) => Ok(Ok(())),"
        }
      ],
      "command": [
        "cargo",
        "+1.97.1",
        "test",
        "-p",
        "grapt-product",
        "--lib",
        "--no-fail-fast",
        "--locked",
        "-j",
        "2",
        "--",
        "dogfood::continuation::compaction::settle_tests::an_interrupt_after_publication_does_not_disown_the_published_descriptor",
        "--exact",
        "--nocapture"
      ],
      "red_contains": [
        "a published compaction was reported as interrupted"
      ]
    },
    {
      "id": "CONTINUITY-INSTRUCTION-FRESHNESS",
      "law": "J01: every request rebuilt after compaction re-reads the applicable current instructions.",
      "edits": [
        {
          "path": "crates/grapt-product/src/dogfood/instructions.rs",
          "before": "        let event: EventId = format!(\"evt_{}\", self.ids.mint().as_str())\n            .parse()\n            .map_err(|error| format!(\"instruction event identity: {error}\"))?;",
          "after": "        let stale = InstructionService::current(inbox.store(), &self.session)\n            .ok()\n            .flatten()\n            .is_some();\n        let event: EventId = format!(\"evt_{}\", self.ids.mint().as_str())\n            .parse()\n            .map_err(|error| format!(\"instruction event identity: {error}\"))?;"
        },
        {
          "path": "crates/grapt-product/src/dogfood/instructions.rs",
          "before": "                    ambient.source,\n",
          "after": "                    if stale {\n                        SourceObservation::Unavailable {\n                            key: key(\"core/instructions\")?,\n                        }\n                    } else {\n                        ambient.source\n                    },\n"
        }
      ],
      "command": [
        "cargo",
        "+1.97.1",
        "test",
        "-p",
        "grapt-product",
        "--features",
        "loopback-provider-testkit",
        "--test",
        "dogfood_headless",
        "--no-fail-fast",
        "--locked",
        "-j",
        "2",
        "--",
        "compaction_continuity::successive_compactions_refresh_instructions_and_replay_exactly",
        "--exact",
        "--nocapture",
        "--test-threads=1"
      ],
      "red_contains": [
        "after the instruction change carried stale instructions"
      ]
    },
