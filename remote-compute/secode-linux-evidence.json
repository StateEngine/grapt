{
  "contract": "remote-compute-profile/v1",
  "runner_contract": "remote-compute-runner/v1",
  "profile_id": "secode-rust-linux",
  "target": {
    "ssh_target": "build-host",
    "remote_run_root": "/home/example/secode-remote-compute/runs",
    "remote_artifact_root": "/home/example/secode-remote-compute/artifacts",
    "connect_timeout_ms": 10000
  },
  "environment": {
    "inherit": ["HOME", "USER"],
    "fixed": {
      "PATH": "/home/example/.cargo/bin:/usr/local/bin:/usr/bin:/bin",
      "CI": "1",
      "LC_ALL": "C",
      "CARGO_INCREMENTAL": "1",
      "CARGO_TERM_COLOR": "never",
      "RUST_BACKTRACE": "1",
      "RUSTDOCFLAGS": "-D warnings",
      "CLIPPY_CONF_DIR": "."
    }
  },
  "toolchain": {
    "checks": [
      {"argv": ["rustc", "+1.97.1", "--version"], "expect": {"stream": "stdout", "match": "exact", "value": "rustc 1.97.1 (8bab26f4f 2026-07-14)"}},
      {"argv": ["cargo", "+1.97.1", "--version"], "expect": {"stream": "stdout", "match": "exact", "value": "cargo 1.97.1 (c980f4866 2026-06-30)"}},
      {"argv": ["cargo", "+1.97.1", "clippy", "--version"], "expect": {"stream": "stdout", "match": "exact", "value": "clippy 0.1.97 (8bab26f4f6 2026-07-14)"}},
      {"argv": ["rustfmt", "+1.97.1", "--version"], "expect": {"stream": "stdout", "match": "exact", "value": "rustfmt 1.9.0-stable (8bab26f4f6 2026-07-14)"}}
    ],
    "bootstrap": [
      ["/home/example/.cargo/bin/rustup", "toolchain", "install", "1.97.1", "--profile", "minimal", "--component", "clippy", "--component", "rustfmt"]
    ],
    "bootstrap_policy": "cache-keyed"
  },
  "cache": {
    "mode": "shared-keyed",
    "namespace": "secode-rust",
    "key": "linux-x86_64-rust-1.97.1-v1",
    "env": {
      "CARGO_HOME": "{{domain}}/cargo-home",
      "RUSTUP_HOME": "{{domain}}/rustup-home",
      "CARGO_TARGET_DIR": "{{domain}}/cargo-target"
    }
  },
  "resources": {
    "domains": {
      "domain0": {"cpu_policy": "host-shared", "memory": {"policy": "runner-unbounded"}, "concurrency": 1, "cache_namespace": "carrier0"},
      "domain1": {"cpu_policy": "host-shared", "memory": {"policy": "runner-unbounded"}, "concurrency": 1, "cache_namespace": "carrier1"}
    },
    "classes": {
      "focused": {"timeout_ms": 1800000, "domains": ["domain0", "domain1"]},
      "full": {"timeout_ms": 43200000, "domains": ["domain0", "domain1"]},
      "final": {"timeout_ms": 86400000, "domains": ["domain0", "domain1"]}
    }
  },
